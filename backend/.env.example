# Copy to .env and adjust. .env is git-ignored.

PORT=4000

# Database: "mongo" now; "memory" keeps everything in RAM (tests and quick demos).
# A "postgres" driver can be added later in src/db/ without touching the routes.
DB_DRIVER=mongo
MONGODB_URI=mongodb://localhost:27017/
DB_NAME=pm_ready

# The main admin (our company). Always an admin once the email is confirmed; the only one who can add/remove admins.
SUPER_ADMIN_EMAIL=
# Extra admins by configuration (optional, comma-separated). Normally the main admin adds admins in the dashboard.
ADMIN_EMAILS=

# Sign-in sessions
SESSION_DAYS=30
# Set to true when the site is served over HTTPS
COOKIE_SECURE=false

# Address of the site, used in email links
APP_URL=http://localhost:4000

# Email (invitations, "added to project", verify email, reset password).
# Local: Mailpit (docker run -d --name pm-ready-mail -p 1025:1025 -p 8025:8025 axllent/mailpit), inbox at http://localhost:8025
# Production: your provider's SMTP, e.g. Gmail (smtp.gmail.com, 465, secure, app password), Resend, Amazon SES, Brevo.
# Leave SMTP_HOST empty to print emails to the server console instead.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=PM Ready <no-reply@pmready.local>

# Sign in with Google: OAuth client from Google Cloud Console (see SETUP.md). Empty = no Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Hosting (the Dockerfile sets these): listen on all interfaces, trust the platform's proxy, HTTPS-only cookies
# HOST=0.0.0.0
# TRUST_PROXY=1
# COOKIE_SECURE=true
