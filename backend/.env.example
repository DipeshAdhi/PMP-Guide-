# Copy to .env and adjust. .env is git-ignored.

PORT=4000

# Database: "mongo" now; "memory" keeps everything in RAM (tests and quick demos).
# A "postgres" driver can be added later in src/db/ without touching the routes.
DB_DRIVER=mongo
MONGODB_URI=mongodb://localhost:27017/
DB_NAME=pm_ready

# Emails that become platform admins (our company) when they register or sign in. Comma-separated.
ADMIN_EMAILS=

# Sign-in sessions
SESSION_DAYS=30
# Set to true when the site is served over HTTPS
COOKIE_SECURE=false
