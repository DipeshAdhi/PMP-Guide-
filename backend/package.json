{
  "name": "pm-ready-backend",
  "version": "0.1.0",
  "private": true,
  "description": "PM Ready API: accounts, companies, projects with access roles, course progress, admin stats",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "make-admin": "node --env-file-if-exists=.env scripts/make-admin.js",
    "test": "node --test test/*.test.js",
    "test:mongo": "TEST_DB_DRIVER=mongo node --env-file-if-exists=.env --test test/*.test.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "mongodb": "^6.10.0",
    "nodemailer": "^6.10.1"
  }
}
